# LLM Provider: openai | gemini | nvidia | local
LLM_PROVIDER=gemini

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Gemini (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# NVIDIA Inference API (required if LLM_PROVIDER=nvidia)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/openai/gpt-oss-20b

# Local Ollama (required if LLM_PROVIDER=local)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2

# CORS origins (comma-separated)
CORS_ORIGINS=https://lvtuan98.github.io,http://localhost:4000

# Email (SMTP)
EMAIL_TO=tuan.lv311098@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
